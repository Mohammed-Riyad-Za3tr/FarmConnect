# ─── Server ────────────────────────────────────────────────────────────────────
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# ─── API authentication (shared secret with apps/api) ────────────────────────
INTERNAL_API_KEY=change-me-internal-secret

# ─── Optional upstream API URL ────────────────────────────────────────────────
API_BASE_URL=http://localhost:4000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

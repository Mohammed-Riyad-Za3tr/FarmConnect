# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────────────
# Local PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmconnect_dev

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-strong-access-secret-min-32
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret-min-32

# ─── CORS ────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ─── AI Service ──────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

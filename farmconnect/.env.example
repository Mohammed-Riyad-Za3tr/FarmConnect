# FarmConnect monorepo environment example
# Copy to .env and adapt values for local, staging, or production.
# Never commit real secrets.

# ─── Global ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API (apps/api) ─────────────────────────────────────────────────────────
API_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmconnect_dev
JWT_ACCESS_SECRET=replace-with-strong-access-secret-min-32
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret-min-32
CLIENT_URL=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
AI_SERVICE_URL=http://localhost:8000

# ─── AI service (apps/ai-service) ───────────────────────────────────────────
AI_HOST=0.0.0.0
AI_PORT=8000
INTERNAL_API_KEY=replace-with-internal-service-key
LOG_LEVEL=INFO

# ─── Web (apps/web) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_APP_NAME=FarmConnect

# ─── Optional deployment hooks (CI/CD) ──────────────────────────────────────
RENDER_DEPLOY_HOOK_API=
RENDER_DEPLOY_HOOK_WEB=
RENDER_DEPLOY_HOOK_AI=
RAILWAY_DEPLOY_HOOK_API=
RAILWAY_DEPLOY_HOOK_WEB=
RAILWAY_DEPLOY_HOOK_AI=

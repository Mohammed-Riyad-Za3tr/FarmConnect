{
  "name": "@farmconnect/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Shared enums, types, schemas, and constants for FarmConnect",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc --project tsconfig.esm.json",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@farmconnect/config": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
